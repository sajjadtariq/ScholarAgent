{
  "name": "pdf-research-chat",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vinext/dist/cli.js dev",
    "build": "node ./node_modules/vinext/dist/cli.js build",
    "start": "node ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --ip 0.0.0.0 --port 3000",
    "lint": "node ./node_modules/oxlint/bin/oxlint .",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts --pool=threads",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "format": "node ./node_modules/oxfmt/bin/oxfmt ."
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260907.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "4.129.1"
  },
  "type": "module"
}
